<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Écran de sélection de fichiers -->
    <LinearLayout
        android:id="@+id/screen_file_selection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:contentDescription="Écran de sélection de fichiers">

        <TextView
            android:id="@+id/tv_selected_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aucun fichier sélectionné"
            android:textSize="18sp"
            android:contentDescription="Nom du fichier sélectionné"/>

        <Button
            android:id="@+id/btn_refresh_files"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rafraîchir"
            android:contentDescription="Bouton Rafraîchir fichiers"/>

        <ScrollView
            android:id="@+id/file_selection_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="Liste de fichiers disponibles">

            <LinearLayout
                android:id="@+id/file_selection_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:contentDescription="Conteneur de boutons de fichiers"/>
        </ScrollView>
    </LinearLayout>

    <!-- Écran d'animation du graphique -->
    <LinearLayout
        android:id="@+id/screen_animation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:contentDescription="Écran d'animation">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status"
            android:textSize="16sp"
            android:contentDescription="Statut de l'analyse"/>

        <TextView
            android:id="@+id/tv_series_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Infos séries"
            android:textSize="16sp"
            android:contentDescription="Informations sur les séries affichées"/>

        <com.qos.latency.analyzer.view.ChartView
            android:id="@+id/chart_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="Graphique de latence"/>

        <Button
            android:id="@+id/btn_launch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lancer"
            android:contentDescription="Bouton Lancer animation"/>

        <Button
            android:id="@+id/btn_change_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Changer de fichier"
            android:contentDescription="Bouton Changer fichier"/>
    </LinearLayout>
</LinearLayout>
