<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- En-tête -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="QoS Gaming"
        android:textColor="#212121"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Container principal -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ÉCRAN 1 : ANIMATION DES rtt_array -->
        <LinearLayout
            android:id="@+id/screen_animation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prêt à démarrer l'analyse"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="#424242"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_series_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chaque série affichera ses latences"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="#666666"
                android:layout_marginBottom="16dp" />

            <!-- Graphique : Latence (ms) vs Points de mesure -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Visualisation en temps réel"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#616161"
                android:layout_marginBottom="8dp" />

            <!-- ChartView MPAndroidChart -->
            <com.qos.latency.analyzer.view.ChartView
                android:id="@+id/chart_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FAFAFA"
                android:layout_marginBottom="20dp" />

            <!-- Bouton de lancement -->
            <Button
                android:id="@+id/btn_launch"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Lancer"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- ÉCRAN 2 : SCORES SIMPLIFIÉ -->
        <LinearLayout
            android:id="@+id/screen_scores"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#F5F5F5">

            <!-- En-tête QoS Gaming -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scores"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Bouton Détail circulaire -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="30dp">

                <Button
                    android:id="@+id/btn_detail_circular"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:text="📊\nDétail"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/circular_button_background"
                    android:elevation="4dp" />

            </LinearLayout>

            <!-- Section Serveur -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Serveur de débit :"
                    android:textSize="14sp"
                    android:textColor="#666666" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OVH 10 Gbps Gravelines"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />

            </LinearLayout>

            <!-- Scores - Style Material -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <!-- Score E-Gaming Principal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🏆 Score e-gaming :"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:layout_gravity="center_vertical" />

                    <TextView
                        android:id="@+id/tv_score_principal_simple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- %"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#2196F3"
                        android:layout_gravity="center_vertical" />

                </LinearLayout>

                <!-- Score Latence -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ Score latence :"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:layout_gravity="center_vertical" />

                    <TextView
                        android:id="@+id/tv_score_latence_simple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- %"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#4CAF50"
                        android:layout_gravity="center_vertical" />

                </LinearLayout>

                <!-- Score Gigue -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 Score gigue :"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:layout_gravity="center_vertical" />

                    <TextView
                        android:id="@+id/tv_score_gigue_simple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- %"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FF9800"
                        android:layout_gravity="center_vertical" />

                </LinearLayout>

                <!-- Score Erreur -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="❌ Score erreur :"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:layout_gravity="center_vertical" />

                    <TextView
                        android:id="@+id/tv_score_erreur_simple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- %"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#F44336"
                        android:layout_gravity="center_vertical" />

                </LinearLayout>

            </LinearLayout>

            <!-- Spacer pour pousser les boutons vers le bas -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Boutons Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Bouton Nouvelle Mesure -->
                <Button
                    android:id="@+id/btn_nouvelle_mesure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔄 Relancer "
                    android:textSize="16sp"
                    android:backgroundTint="#757575"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

        <!-- ÉCRAN 3 : BOXPLOT avec MPAndroidChart -->
        <LinearLayout
            android:id="@+id/screen_boxplot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#F5F5F5">

            <!-- En-tête BoxPlot -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp">

                <Button
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:text="📈\Détails"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/circular_button_background"
                    android:elevation="2dp" />
            </LinearLayout>

            <!-- Section Serveur (identique) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Serveur de débit :"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OVH 10 Gbps Gravelines"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />

            </LinearLayout>

            <!-- Container BoxPlot MPAndroidChart -->
            <FrameLayout
                android:id="@+id/boxplot_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <!-- BoxPlotChartView sera ajoutée ici programmatiquement -->

            </FrameLayout>

            <!-- Boutons Navigation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <Button
                    android:id="@+id/btn_retour_scores"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="← Retour"
                    android:textSize="16sp"
                    android:backgroundTint="#607D8B"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_detail_sous_scores"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📊 Sous-Scores"
                    android:textSize="16sp"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ÉCRAN 4 : DÉTAIL SOUS-SCORES avec MPAndroidChart -->
        <LinearLayout
            android:id="@+id/screen_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#F5F5F5">

            <!-- En-tête détail -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 Scores Détaillés"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Container pour les scores détaillés MPAndroidChart -->
            <FrameLayout
                android:id="@+id/detail_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <!-- DetailedScoresChartView sera ajoutée ici programmatiquement -->

            </FrameLayout>

            <!-- Bouton retour -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <Button
                    android:id="@+id/btn_retour_boxplot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="← Retour"
                    android:textSize="16sp"
                    android:backgroundTint="#607D8B"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>